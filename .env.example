PORT=5000
# AI scoring (optional; rules-based scoring is used without a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Path to a text file describing your ideal customer
ICP_FILE=

# CRM (leave empty to run with an in-memory demo CRM)
HUBSPOT_TOKEN=

# Security
WEBHOOK_SECRET=change-me
ADMIN_KEY=change-me-too

# Follow-up emails
SENDER_NAME=Muhammad
CALENDAR_URL=https://cal.example.com/intro
# Option A: n8n / Make webhook that sends the email via Gmail or Outlook
SEND_WEBHOOK_URL=
# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DB_PATH=data/leads.db
